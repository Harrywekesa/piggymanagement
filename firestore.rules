rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // shared_buyers — National Kenya Pig Buyer Directory
    //
    // - READ: Any authenticated user can read the shared directory
    //         (all farmers across Kenya should see community buyers).
    // - CREATE/UPDATE: Any authenticated user can add/update a buyer,
    //         BUT the document MUST include non-empty 'name' and 'phone' fields.
    //         No garbage or spam documents can be inserted.
    // - DELETE: NOT allowed. Community buyers are permanent records.
    //           A future admin function may handle curation.
    // ─────────────────────────────────────────────────────────────────────────
    match /shared_buyers/{buyerId} {
      // Allow reads by any signed-in user
      allow read: if request.auth != null;

      // Allow creates if user is signed in and the document has required fields
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['name', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0;

      // Allow updates only from the original uploader OR if same phone document
      // (Any farmer can refresh their own buyer entry)
      allow update: if request.auth != null
                    && request.resource.data.keys().hasAll(['name', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;

      // Deletes are locked — shared directory entries are permanent
      allow delete: if false;
    }

    // All other collections are denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
